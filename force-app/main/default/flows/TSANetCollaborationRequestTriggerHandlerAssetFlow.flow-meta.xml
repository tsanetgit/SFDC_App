<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>AssetResult</name>
        <label>Asset Result</label>
        <locationX>647</locationX>
        <locationY>515</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>AssetFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetAsset</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CreateSalesforceCaseRecord</targetReference>
            </connector>
            <label>Asset Found</label>
        </rules>
        <rules>
            <name>AssetNotFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetAsset</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>TSANetRequestInfoAutomation</targetReference>
            </connector>
            <label>Asset Not Found</label>
        </rules>
    </decisions>
    <description>Record-triggered flow that handles inbound collaboration request lifecycle events for asset-related cases.</description>
    <environments>Default</environments>
    <formulas>
        <name>CasePriority</name>
        <dataType>String</dataType>
        <expression>CASE({!$Record.tsanetconnect__Priority__c}, &apos;LOW&apos;, &apos;Low&apos;, &apos;MEDIUM&apos;, &apos;Medium&apos;, &apos;HIGH&apos;, &apos;High&apos;, &apos;&apos;)</expression>
    </formulas>
    <interviewLabel>TSANet Collaboration Request Trigger Handler ( Asset ) {!$Flow.CurrentDateTime}</interviewLabel>
    <isTemplate>true</isTemplate>
    <label>TSANet: Inbound: Collaboration Request Trigger Handler (Asset)</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>CreateSalesforceCaseRecord</name>
        <label>Create Salesforce Case Record</label>
        <locationX>871</locationX>
        <locationY>514</locationY>
        <connector>
            <targetReference>AttachCaseToCollaborationRequest</targetReference>
        </connector>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>$Record.Description__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Origin</field>
            <value>
                <stringValue>Web</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <elementReference>CasePriority</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Type</field>
            <value>
                <stringValue>Other</stringValue>
            </value>
        </inputAssignments>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>GetAsset</name>
        <label>Get Asset</label>
        <locationX>655</locationX>
        <locationY>380</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>AssetResult</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.TSANetEmail__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Asset</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>AttachCaseToCollaborationRequest</name>
        <label>Attach Case to Collaboration Request</label>
        <locationX>871</locationX>
        <locationY>658</locationY>
        <connector>
            <targetReference>TSANetAcceptAutomation</targetReference>
        </connector>
        <inputAssignments>
            <field>Case__c</field>
            <value>
                <elementReference>CreateSalesforceCaseRecord</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>529</locationX>
        <locationY>48</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Case__c</field>
            <operator>EqualTo</operator>
        </filters>
        <filters>
            <field>Direction__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>INBOUND</stringValue>
            </value>
        </filters>
        <object>TSANetCase__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>GetAsset</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <subflows>
        <name>SendNotification</name>
        <label>Send Notification</label>
        <locationX>871</locationX>
        <locationY>939</locationY>
        <flowName>TSANetNotification</flowName>
        <inputAssignments>
            <name>body</name>
            <value>
                <stringValue>Your case has been successfully confirmed and is now being processed</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>TSANetCase</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>TSANetAcceptAutomation</name>
        <label>TSANet Accept ( Automation )</label>
        <locationX>871</locationX>
        <locationY>799</locationY>
        <connector>
            <targetReference>SendNotification</targetReference>
        </connector>
        <flowName>TSANetAcceptAutomation</flowName>
        <inputAssignments>
            <name>Note</name>
            <value>
                <stringValue>Your request is approved! One of our agents will contact you shortly.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <subflows>
        <name>TSANetRequestInfoAutomation</name>
        <label>TSANet Request Info ( Automation )</label>
        <locationX>445</locationX>
        <locationY>514</locationY>
        <flowName>TSANetRequestInfoAutomation</flowName>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>RequestedInformation</name>
            <value>
                <stringValue>Please provide asset number!</stringValue>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <variables>
        <name>recipientIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
