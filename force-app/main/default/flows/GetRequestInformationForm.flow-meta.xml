<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>FillInRequestInformationForm</name>
        <label>Fill in the Request Information Form</label>
        <locationX>572</locationX>
        <locationY>215</locationY>
        <assignmentItems>
            <assignToReference>RequestInformationForm.engineerName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>SubmitterName</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>RequestInformationForm.engineerEmail</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>SubmitterEmail</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>RequestInformationForm.engineerPhone</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>SubmitterPhone</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>RequestInformationForm.requestedInformation</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>RequestedInformation</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Autolaunched flow that builds and returns the &quot;Request More Information&quot; form payload for API requests.</description>
    <environments>Default</environments>
    <formulas>
        <name>SubmitterEmail</name>
        <dataType>String</dataType>
        <expression>IF({!TSANetCase.Case__r.Owner:User.Email} != &apos;&apos;, {!TSANetCase.Case__r.Owner:User.Email}, {!$User.Email})</expression>
    </formulas>
    <formulas>
        <name>SubmitterName</name>
        <dataType>String</dataType>
        <expression>IF( {!TSANetCase.Case__r.Owner:User.Name} != &apos;&apos;, {!TSANetCase.Case__r.Owner:User.Name}, {!$User.FirstName} + &apos; &apos; + {!$User.LastName})</expression>
    </formulas>
    <formulas>
        <name>SubmitterPhone</name>
        <dataType>String</dataType>
        <expression>IF({!TSANetCase.Owner:User.Phone} != &apos;&apos;, {!TSANetCase.Owner:User.Phone}, {!$User.Phone})</expression>
    </formulas>
    <interviewLabel>GetRequestInfoForm {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Get Request Information Form</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>446</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>FillInRequestInformationForm</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>RequestedInformation</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>RequestInformationForm</name>
        <apexClass>tsanetconnect__TSANetRequestInfoForm</apexClass>
        <dataType>Apex</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>TSANetCase</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
