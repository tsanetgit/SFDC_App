    <decisions>
        <name>Check_Direction</name>
        <label>Case Direction?</label>
        <locationX>269</locationX>
        <locationY>324</locationY>
        <defaultConnector>
            <targetReference>Get_Case_By_Receiver_Number</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Inbound</defaultConnectorLabel>
        <rules>
            <name>Is_Outbound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.tsanetconnect__Direction__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>OUTBOUND</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Case_By_Submitter_Number</targetReference>
            </connector>
            <label>Outbound</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Receiver_Match</name>
        <label>Receiver Match Found?</label>
        <locationX>484</locationX>
        <locationY>522</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Receiver_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case_By_Receiver_Number</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Stamp_From_Receiver_Match</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Submitter_Match</name>
