    </assignments>
    <assignments>
        <name>Stamp_From_Submitter_Match</name>
        <label>Stamp Case from Submitter Match</label>
        <locationX>56</locationX>
        <locationY>757</locationY>
        <assignmentItems>
            <assignToReference>$Record.tsanetconnect__Case__c</assignToReference>
