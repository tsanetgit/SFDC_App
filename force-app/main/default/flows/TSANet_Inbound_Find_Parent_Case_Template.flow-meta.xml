        <locationX>50</locationX>
        <locationY>532</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Submitter_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case_By_Submitter_Number</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Stamp_From_Submitter_Match</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Template before-save record-triggered flow on TSANetCase__c. Branches on Direction__c: Outbound cases look up the parent Case by SubmitterCaseNumber__c, Inbound cases by ReceiverCaseNumber__c, then stamp Case__c on the new record. Runs in the Integration User or end-user context. Subscribers clone this template into their own flow and activate it.</description>
    <environments>Default</environments>
    <interviewLabel>TSANet Inbound: Find Parent Case {!$Flow.CurrentDateTime}</interviewLabel>
    <isTemplate>true</isTemplate>
    <label>TSANet: Inbound: Find Parent Case ( Template )</label>
    <processMetadataValues>
