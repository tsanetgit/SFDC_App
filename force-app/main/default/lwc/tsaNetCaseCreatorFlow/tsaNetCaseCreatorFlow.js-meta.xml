<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>TSANet Create Collaboration Case</masterLabel>
    <description>Full wizard to create an outbound TSANet collaboration request</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="caseId" type="String" label="Case Id" required="true" />
            <property name="searchText" type="String" label="Initial Search Text"
                description="Pre-populates the member search field" />
            <property name="isSuccess" type="Boolean" label="Is Success" role="outputOnly" />
            <property name="tsanetRequestId" type="String" label="TSANet Request Id" role="outputOnly" />
            <property name="responseJson" type="String" label="Response JSON" role="outputOnly" />
            <property name="errorMessage" type="String" label="Error Message" role="outputOnly" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
